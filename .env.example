# AirCue Environment Variables
# Copy this file to .env and fill in required keys

# OpenRouter API Key (Required for running live LLM benchmarks)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: OpenAQ v3 API Key (for physical reference station data)
OPENAQ_API_KEY=

# Optional: Direct Provider API Keys (alternative to OpenRouter)
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Optional: Anthropic Claude API Key (for future benchmark runs via config)
ANTHROPIC_API_KEY=

# System / MQTT Broker (default localhost)
AIRCUE_MQTT_HOST=localhost
AIRCUE_MQTT_PORT=1883
AIRCUE_SITE=indore_school_01
